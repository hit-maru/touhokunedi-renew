---
// src/pages/news/[page].astro
import Layout from '../../layouts/Layout.astro';
import { getNews, client } from '../../lib/microcms';
import { format } from 'date-fns';

const CATEGORIES = ['製品情報', '展示会', 'イベント', 'ニュース'];
const LINKEDIN_EMBED_URL =
  "https://www.linkedin.com/embed/feed/update/urn:li:share:7417757853383307264";
const LINKEDIN_IFRAME_HEIGHT = 600;

export async function getStaticPaths() {
  const PER_PAGE = 10;
  // 全件取得（100件制限を回避）
  const allContents = await client.getAllContents({
    endpoint: 'news',
    queries: {
      fields: 'id,title,date,category,thumbnail',
      orders: '-date'
    }
  });
  const all = { contents: allContents };
  const total = allContents.length;
  const totalPages = Math.ceil(total / PER_PAGE);

  return Array.from({ length: totalPages }, (_, i) => ({
    params: { page: String(i + 1) },
    props: {
      news: all.contents.slice(i * PER_PAGE, (i + 1) * PER_PAGE),
      totalPages,
      currentPage: i + 1,
      allNews: all.contents,
    },
  }));
}

const { news, totalPages, currentPage, allNews } = Astro.props;

const categoryCounts = CATEGORIES.reduce<Record<string, number>>((counts, category) => {
  counts[category] = allNews.filter((post: any) => {
    const categories = Array.isArray(post.category) ? post.category : [];
    return categories.includes(category);
  }).length;
  return counts;
}, {});

const availableCategories = CATEGORIES.filter((category) => categoryCounts[category] > 0);

const clientNews = allNews.map((post: any) => ({
  id: post.id,
  title: post.title,
  date: post.date,
  category: Array.isArray(post.category) ? post.category : [],
  thumbnail: post.thumbnail ? { url: post.thumbnail.url } : null,
}));

const newsJson = JSON.stringify(clientNews).replace(/[<>&\u2028\u2029]/g, (char) => {
  const escapes: Record<string, string> = {
    '<': '\\u003c',
    '>': '\\u003e',
    '&': '\\u0026',
    '\u2028': '\\u2028',
    '\u2029': '\\u2029',
  };
  return escapes[char];
});

// 年度一覧
const years = [...new Set(
  allNews.map((p: any) => new Date(p.date).getFullYear())
)].sort((a: number, b: number) => b - a);

// ページ番号リスト生成（省略なし・シンプル版）
function getPageNumbers(current: number, total: number): (number | '...')[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
  const pages: (number | '...')[] = [];
  pages.push(1);
  if (current > 4) pages.push('...');
  for (let i = Math.max(2, current - 2); i <= Math.min(total - 1, current + 2); i++) {
    pages.push(i);
  }
  if (current < total - 3) pages.push('...');
  pages.push(total);
  return pages;
}

const pageNumbers = getPageNumbers(currentPage, totalPages);
---

<Layout title={`お知らせ - ${currentPage}ページ目`}>

  <div class="bg-gray-100 pt-[90px] pb-8 border-b border-gray-200">
    <div class="container mx-auto px-6">
      <h1 class="text-4xl md:text-5xl font-mincho font-bold text-[#008B9B] mb-4">お知らせ</h1>
      <p class="text-gray-500 font-serif tracking-wider uppercase">NEWS</p>
    </div>
  </div>

  <section class="py-16 bg-white">
    <div class="container mx-auto px-6 max-w-6xl">
      <div class="flex flex-col lg:flex-row gap-12">

        <!-- メインコンテンツ -->
        <div class="flex-1">

          <!-- カテゴリフィルタ（上部） -->
          <div class="flex flex-wrap gap-2 mb-8">
            <button data-category="" class="category-btn text-xs font-bold px-4 py-2 border border-[#008B9B] bg-[#008B9B] text-white rounded-sm transition-colors">
              すべて
            </button>
            {availableCategories.map(cat => (
              <button
                data-category={cat}
                class="category-btn text-xs font-bold px-4 py-2 border border-gray-300 text-gray-600 rounded-sm hover:border-[#008B9B] hover:text-[#008B9B] transition-colors"
              >
                {cat}
              </button>
            ))}
          </div>

          <!-- 記事一覧 -->
          <ul class="border-t border-gray-200" id="news-list">
            {news.map((post: any) => (
              <li
                class="news-item border-b border-gray-200"
                data-category={post.category?.[0] ?? ''}
                data-year={String(new Date(post.date).getFullYear())}
              >
                <a href={`/news/${post.id}`} class="block py-6 group transition-colors hover:bg-gray-50 px-4">
                  <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] md:grid-cols-[4.75rem_4.75rem_7.56rem_minmax(0,1fr)_1rem] items-center gap-x-3 md:gap-x-0 gap-y-4">
                    <time datetime={post.date} class="text-gray-400 font-serif text-sm tracking-tighter">
                        {format(new Date(post.date), 'yyyy.MM.dd')}
                    </time>
                    <div class="min-w-0">
                      {post.category && post.category.length > 0 ? (
                        <span class="inline-flex max-w-full items-center px-2 py-1 bg-gray-100 text-[#008B9B] rounded-sm text-[10px] font-bold uppercase tracking-widest">
                          <span class="truncate">{post.category[0]}</span>
                        </span>
                      ) : (
                        <span class="block h-6" aria-hidden="true"></span>
                      )}
                    </div>
                    <div class="col-start-1 row-start-2 md:col-start-auto md:row-start-auto h-20 md:h-[5.4rem] overflow-hidden rounded-sm">
                      {post.thumbnail ? (
                        <img
                          src={post.thumbnail.url}
                          alt={post.title}
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                        />
                      ) : (
                        <div class="hidden md:block w-full h-full"></div>
                      )}
                    </div>
                    <h3 class="col-start-2 row-start-2 md:col-start-auto md:row-start-auto md:pl-4 text-gray-800 font-sans text-[15px] md:text-[16px] font-bold leading-relaxed group-hover:text-[#E64A19] transition-colors">
                      {post.title}
                    </h3>
                    <div class="hidden md:block text-gray-300 group-hover:text-[#E64A19] transform group-hover:translate-x-1 transition-all">
                      →
                    </div>
                  </div>
                </a>
              </li>
            ))}
          </ul>
          <p id="news-empty" class="hidden border-t border-b border-gray-200 py-10 px-4 text-center text-gray-500">
            該当するお知らせはありません。
          </p>

          <!-- ページネーション -->
          <nav id="news-pagination" class="mt-12 flex justify-center items-center gap-1" aria-label="ページ送り">
            {currentPage > 1 && (
              <a href={`/news/${currentPage - 1}`} class="w-9 h-9 flex items-center justify-center border border-gray-300 text-gray-600 hover:border-[#008B9B] hover:text-[#008B9B] transition-colors text-sm">
                ‹
              </a>
            )}

            {pageNumbers.map((p) => (
              p === '...'
                ? <span class="w-9 h-9 flex items-center justify-center text-gray-400 text-sm">...</span>
                : <a
                    href={`/news/${p}`}
                    class={`w-9 h-9 flex items-center justify-center border text-sm transition-colors ${
                      p === currentPage
                        ? 'border-[#008B9B] bg-[#008B9B] text-white'
                        : 'border-gray-300 text-gray-600 hover:border-[#008B9B] hover:text-[#008B9B]'
                    }`}
                  >
                    {p}
                  </a>
            ))}

            {currentPage < totalPages && (
              <a href={`/news/${currentPage + 1}`} class="w-9 h-9 flex items-center justify-center border border-gray-300 text-gray-600 hover:border-[#008B9B] hover:text-[#008B9B] transition-colors text-sm">
                ›
              </a>
            )}
          </nav>

        </div>

        <!-- サイドバー -->
        <aside class="lg:w-56 shrink-0">

          <!-- 年度フィルタ -->
          <div class="mb-8">
            <h2 class="text-sm font-bold text-gray-700 mb-3 pb-2 border-b border-gray-200 tracking-wider uppercase">年度で絞り込む</h2>
            <ul class="space-y-1">
              <li>
                <button data-year="" class="year-btn w-full text-left text-sm px-3 py-2 text-[#008B9B] font-bold hover:bg-gray-50 transition-colors">
                  すべての年度
                </button>
              </li>
              {years.map((year: number) => (
                <li>
                  <button
                    data-year={String(year)}
                    class="year-btn w-full text-left text-sm px-3 py-2 text-gray-600 hover:text-[#008B9B] hover:bg-gray-50 transition-colors flex items-center gap-2"
                  >
                    <span class="text-gray-400">›</span>
                    {year}年
                  </button>
                </li>
              ))}
            </ul>
          </div>

          <!-- カテゴリ（サイドバー） -->
          <div>
            <h2 class="text-sm font-bold text-gray-700 mb-3 pb-2 border-b border-gray-200 tracking-wider uppercase">カテゴリ</h2>
            <ul class="space-y-1">
              {availableCategories.map(cat => (
                <li>
                  <button
                    data-category={cat}
                    class="category-sidebar-btn w-full text-left text-sm px-3 py-2 text-gray-600 hover:text-[#008B9B] hover:bg-gray-50 transition-colors flex items-center gap-2"
                  >
                    <span class="text-gray-400">›</span>
                    {cat}
                  </button>
                </li>
              ))}
            </ul>
          </div>

        </aside>
      </div>
    </div>
  </section>

  {/* --- ソーシャルメディアセクション --- */}
  <section class="py-12 md:py-16 bg-gray-50 border-t border-gray-100">
    <div class="container mx-auto px-6 max-w-6xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
        <div class="flex flex-col">
          <a
            href="https://www.linkedin.com/company/%E6%9D%B1%E5%8C%97%E3%83%8D%E3%83%82%E8%A3%BD%E9%80%A0%EF%BC%88%E6%A0%AA%EF%BC%89/posts/?feedView=all"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-[#008B9B] text-white px-6 py-3 rounded-t-sm shadow-sm flex justify-between items-center"
          >
            <span class="font-['Barlow_Condensed'] text-lg sm:text-xl font-bold text-white">Our LinkedIn Site</span>
            <span class="hidden sm:inline text-xs opacity-80 text-white">View latest updates →</span>
          </a>
          <div class="bg-white border-x border-b border-gray-200 shadow-sm rounded-b-sm overflow-hidden p-1 h-[600px] overflow-y-auto custom-scrollbar">
            <iframe
              src={LINKEDIN_EMBED_URL}
              height={LINKEDIN_IFRAME_HEIGHT}
              width="100%"
              frameborder="0"
              allowfullscreen
              title="LinkedIn Post"
              class="w-full"
            ></iframe>
          </div>
        </div>
        <div class="hidden md:flex flex-col">
          <div class="bg-[#008B9B] text-white px-6 py-3 rounded-t-sm shadow-sm flex justify-between items-center">
            <span class="font-['Barlow_Condensed'] text-lg sm:text-xl font-bold text-white">Our Instagram</span>
            <a href="https://www.instagram.com/tohokubolt_official/" target="_blank" rel="noopener noreferrer" class="hidden sm:inline text-xs opacity-80 text-white">View on Instagram →</a>
          </div>
          <div class="bg-white border-x border-b border-gray-200 shadow-sm rounded-b-sm overflow-hidden h-[600px] overflow-y-auto">
            <script is:inline src="https://elfsightcdn.com/platform.js" async></script>
            <div class="elfsight-app-0deee985-68ee-44ea-80b7-26596f3a7523" data-elfsight-app-lazy></div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script type="application/json" id="news-data" set:html={newsJson}></script>

<script define:vars={{ currentPage }}>
  const PER_PAGE = 10;
  const newsDataElement = document.getElementById('news-data');
  const allNews = newsDataElement?.textContent ? JSON.parse(newsDataElement.textContent) : [];
  const initialPage = Number(currentPage) || 1;
  let activeCategory = '';
  let activeYear = '';
  let activePage = initialPage;

  function pagePath(page) {
    return page === 1 ? '/news/1' : `/news/${page}`;
  }

  function getPageNumbers(current, total) {
    if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
    const pages = [1];
    if (current > 4) pages.push('...');
    for (let i = Math.max(2, current - 2); i <= Math.min(total - 1, current + 2); i += 1) {
      pages.push(i);
    }
    if (current < total - 3) pages.push('...');
    pages.push(total);
    return pages;
  }

  function formatDate(dateString) {
    const date = new Date(dateString);
    if (Number.isNaN(date.getTime())) return '';
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');
    return `${year}.${month}.${day}`;
  }

  function filteredNews() {
    return allNews.filter((post) => {
      const year = String(new Date(post.date).getFullYear());
      const categories = Array.isArray(post.category) ? post.category : [];
      const yearMatch = !activeYear || year === activeYear;
      const categoryMatch = !activeCategory || categories.includes(activeCategory);
      return yearMatch && categoryMatch;
    });
  }

  function createNewsItem(post) {
    const item = document.createElement('li');
    item.className = 'news-item border-b border-gray-200';
    item.dataset.category = Array.isArray(post.category) ? post.category[0] || '' : '';
    item.dataset.year = String(new Date(post.date).getFullYear());

    const link = document.createElement('a');
    link.href = `/news/${post.id}`;
    link.className = 'block py-6 group transition-colors hover:bg-gray-50 px-4';

    const row = document.createElement('div');
    row.className = 'grid grid-cols-[6.5rem_minmax(0,1fr)] md:grid-cols-[4.75rem_4.75rem_7.56rem_minmax(0,1fr)_1rem] items-center gap-x-3 md:gap-x-0 gap-y-4';

    const time = document.createElement('time');
    time.dateTime = post.date;
    time.className = 'text-gray-400 font-serif text-sm tracking-tighter';
    time.textContent = formatDate(post.date);
    row.appendChild(time);

    const categoryWrap = document.createElement('div');
    categoryWrap.className = 'min-w-0';

    const firstCategory = Array.isArray(post.category) ? post.category[0] : '';
    if (firstCategory) {
      const category = document.createElement('span');
      category.className = 'inline-flex max-w-full items-center px-2 py-1 bg-gray-100 text-[#008B9B] rounded-sm text-[10px] font-bold uppercase tracking-widest';
      const categoryText = document.createElement('span');
      categoryText.className = 'truncate';
      categoryText.textContent = firstCategory;
      category.appendChild(categoryText);
      categoryWrap.appendChild(category);
    } else {
      const placeholder = document.createElement('span');
      placeholder.className = 'block h-6';
      placeholder.setAttribute('aria-hidden', 'true');
      categoryWrap.appendChild(placeholder);
    }
    row.appendChild(categoryWrap);

    const thumbWrap = document.createElement('div');
    thumbWrap.className = 'col-start-1 row-start-2 md:col-start-auto md:row-start-auto h-20 md:h-[5.4rem] overflow-hidden rounded-sm';

    if (post.thumbnail?.url) {
      const img = document.createElement('img');
      img.src = post.thumbnail.url;
      img.alt = post.title || '';
      img.className = 'w-full h-full object-cover group-hover:scale-105 transition-transform duration-300';
      thumbWrap.appendChild(img);
    } else {
      const placeholder = document.createElement('div');
      placeholder.className = 'hidden md:block w-full h-full';
      thumbWrap.appendChild(placeholder);
    }
    row.appendChild(thumbWrap);

    const title = document.createElement('h3');
    title.className = 'col-start-2 row-start-2 md:col-start-auto md:row-start-auto md:pl-4 text-gray-800 font-sans text-[15px] md:text-[16px] font-bold leading-relaxed group-hover:text-[#E64A19] transition-colors';
    title.textContent = post.title || '';
    row.appendChild(title);

    const arrow = document.createElement('div');
    arrow.className = 'hidden md:block text-gray-300 group-hover:text-[#E64A19] transform group-hover:translate-x-1 transition-all';
    arrow.textContent = '→';
    row.appendChild(arrow);

    link.appendChild(row);
    item.appendChild(link);
    return item;
  }

  function paginationLink(label, page, isActive = false) {
    const link = document.createElement('a');
    link.href = pagePath(page);
    link.textContent = label;
    link.className = isActive
      ? 'w-9 h-9 flex items-center justify-center border text-sm transition-colors border-[#008B9B] bg-[#008B9B] text-white'
      : 'w-9 h-9 flex items-center justify-center border text-sm transition-colors border-gray-300 text-gray-600 hover:border-[#008B9B] hover:text-[#008B9B]';
    link.addEventListener('click', (event) => {
      event.preventDefault();
      activePage = page;
      renderNews();
    });
    return link;
  }

  function renderPagination(totalPagesForFilter) {
    const pagination = document.getElementById('news-pagination');
    if (!pagination) return;
    pagination.replaceChildren();
    pagination.classList.toggle('hidden', totalPagesForFilter <= 1);

    if (totalPagesForFilter <= 1) return;

    if (activePage > 1) {
      pagination.appendChild(paginationLink('‹', activePage - 1));
    }

    getPageNumbers(activePage, totalPagesForFilter).forEach((page) => {
      if (page === '...') {
        const span = document.createElement('span');
        span.className = 'w-9 h-9 flex items-center justify-center text-gray-400 text-sm';
        span.textContent = '...';
        pagination.appendChild(span);
        return;
      }
      pagination.appendChild(paginationLink(String(page), page, page === activePage));
    });

    if (activePage < totalPagesForFilter) {
      pagination.appendChild(paginationLink('›', activePage + 1));
    }
  }

  function renderNews() {
    const list = document.getElementById('news-list');
    const emptyMessage = document.getElementById('news-empty');
    if (!list || !emptyMessage) return;

    const matched = filteredNews();
    const totalPagesForFilter = Math.max(1, Math.ceil(matched.length / PER_PAGE));
    activePage = Math.min(Math.max(activePage, 1), totalPagesForFilter);
    const pageItems = matched.slice((activePage - 1) * PER_PAGE, activePage * PER_PAGE);

    list.replaceChildren(...pageItems.map(createNewsItem));
    list.classList.toggle('hidden', pageItems.length === 0);
    emptyMessage.classList.toggle('hidden', matched.length !== 0);
    renderPagination(matched.length === 0 ? 0 : totalPagesForFilter);
  }

  function setCategoryButtonState() {
    document.querySelectorAll('.category-btn').forEach((button) => {
      const selected = (button.getAttribute('data-category') ?? '') === activeCategory;
      button.classList.toggle('bg-[#008B9B]', selected);
      button.classList.toggle('text-white', selected);
      button.classList.toggle('border-[#008B9B]', selected);
      button.classList.toggle('border-gray-300', !selected);
      button.classList.toggle('text-gray-600', !selected);
    });

    document.querySelectorAll('.category-sidebar-btn').forEach((button) => {
      const selected = (button.getAttribute('data-category') ?? '') === activeCategory;
      button.classList.toggle('text-[#008B9B]', selected);
      button.classList.toggle('font-bold', selected);
      button.classList.toggle('text-gray-600', !selected);
    });
  }

  function setYearButtonState() {
    document.querySelectorAll('.year-btn').forEach((button) => {
      const selected = (button.getAttribute('data-year') ?? '') === activeYear;
      button.classList.toggle('text-[#008B9B]', selected);
      button.classList.toggle('font-bold', selected);
      button.classList.toggle('text-gray-600', !selected);
    });
  }

  document.querySelectorAll('.category-btn').forEach((button) => {
    button.addEventListener('click', () => {
      activeCategory = button.getAttribute('data-category') ?? '';
      activePage = 1;
      setCategoryButtonState();
      renderNews();
    });
  });

  document.querySelectorAll('.category-sidebar-btn').forEach((button) => {
    button.addEventListener('click', () => {
      activeCategory = button.getAttribute('data-category') ?? '';
      activePage = 1;
      setCategoryButtonState();
      renderNews();
    });
  });

  document.querySelectorAll('.year-btn').forEach((button) => {
    button.addEventListener('click', () => {
      activeYear = button.getAttribute('data-year') ?? '';
      activePage = 1;
      setYearButtonState();
      renderNews();
    });
  });

  setCategoryButtonState();
  setYearButtonState();
  renderNews();
</script>
